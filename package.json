{
  "name": "ai-image-detector",
  "version": "0.1.0",
  "description": "MV3 Chrome extension that detects AI-generated images fully in-browser. No cloud, no telemetry — every image is analyzed on-device.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "affaffaff",
  "repository": {
    "type": "git",
    "url": "https://github.com/affaffaff/ai-image-detector.git"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "onnxruntime-web": "1.27.0"
  },
  "devDependencies": {
    "@types/chrome": "0.2.5",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
