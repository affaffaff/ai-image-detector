# Reproducibility: every dependency is pinned exactly.
save-exact=true

# NOT engine-strict. Byte-identical output comes from the pinned esbuild and
# the committed lockfile, not from the Node major version — build.mjs uses only
# stable node:fs/path/crypto/url APIs. A hard engine gate would fail `npm ci`
# outright for a reviewer on Node 22/24 LTS, turning a non-issue into a
# "does not build from source" verdict. .nvmrc still pins the version CI uses.
