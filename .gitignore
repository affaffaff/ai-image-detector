# PRIVATE — local AI instructions, strategy, benchmark planning, and eval data.
# These files stay on the development machine and must never be committed.
/CLAUDE.md
/.claude/
/notes/
/docs/benchmark-replica.md

# Dependencies
/node_modules/

*.onnx

# dist/ IS committed so people can load the extension in Chrome directly.
# Exception: bundled int8 model inside dist must not be ignored by *.onnx.
!/dist/**/*.onnx

# Eval datasets and score arrays stay private and are never committed
/data/
*.npy
*.npz

# Python
__pycache__/
*.py[cod]
/.venv/
/.venv-export/
/.venv-generate/
/.venv-data/
/.cache/

# Editor / OS noise
.DS_Store
Thumbs.db
*.log
.cursor/

/gallery/

# Source model weights are downloaded at setup and hash-verified
# The pinned INT8 shipping artifact IS committed — git already stores the same
# blob via dist/, so tracking it here costs zero bytes and lets a fresh clone
# run the bundling build. The FP32 export stays local-only forever.
/models/weights/*
# Keep metadata tracked
!/models/weights/export-metadata.json
!/models/weights/community-forensics-384-int8.onnx
