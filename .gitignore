# PRIVATE — local AI instructions, strategy, benchmark planning, and eval data.
# These files stay on the development machine and must never be committed.
/CLAUDE.md
/.claude/
/notes/
/docs/benchmark-replica.md

# Dependencies and build output
/node_modules/
/dist/

# Model weights are downloaded at setup and hash-verified against
# models/manifest.json (which IS committed). Weight binaries never enter git.
/models/weights/
*.onnx

# Eval datasets and score arrays stay private and are never committed
/data/
*.npy
*.npz

# Python
__pycache__/
*.py[cod]
/.venv/
/.venv-export/
/.venv-generate/
/.venv-data/
/.cache/

# Editor / OS noise
.DS_Store
Thumbs.db
*.log
